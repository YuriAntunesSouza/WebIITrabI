generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  password            String
  role                String   @default("comprador")
  isActive            Int      @default(0)
  isVerified          Int      @default(0)
  verificationCode    String?
  verificationExpires BigInt?
  createdAt           DateTime @default(now())

  Logs           Log[]
  Products       Product[]
  BuyerProfile   BuyerProfile?
  SellerProfile  SellerProfile?
  Comments       Comment[]
  CommentLikes   CommentLike[]
  Orders         Order[]
}

model Log {
  id          Int      @id @default(autoincrement())
  userId      Int?
  method      String
  route       String
  description String
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  userId      Int
  User        User     @relation(fields: [userId], references: [id])
  Images      ProductImage[]
  Comments    Comment[]
  OrderItems  OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  isPrimary Int     @default(0)
  productId Int
  Product   Product @relation(fields: [productId], references: [id])
}

model BuyerProfile {
  id            Int    @id @default(autoincrement())
  phone         String
  address       String
  city          String
  state         String
  zipCode       String
  paymentMethod String
  userId        Int    @unique
  User          User   @relation(fields: [userId], references: [id])
}

model SellerProfile {
  id          Int    @id @default(autoincrement())
  storeName   String
  description String
  contact     String
  city        String
  state       String
  categories  String
  userId      Int    @unique
  User        User   @relation(fields: [userId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())
  productId Int
  Product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  User      User     @relation(fields: [userId], references: [id])
  Likes     CommentLike[]
}

model Order {
  id        Int         @id @default(autoincrement())
  status    String      @default("pendente")
  total     Float
  createdAt DateTime    @default(now())
  userId    Int
  User      User        @relation(fields: [userId], references: [id])
  Items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Float
  orderId   Int
  productId Int
  Order     Order   @relation(fields: [orderId], references: [id])
  Product   Product @relation(fields: [productId], references: [id])
}

model CommentLike {
  id        Int  @id @default(autoincrement())
  commentId Int
  userId    Int
  Comment   Comment @relation(fields: [commentId], references: [id])
  User      User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}