<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Logs do sistema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Auditoria da plataforma</p>
              <h1 class="mt-1 font-display text-3xl font-bold">Logs do sistema</h1>
              <p class="mt-2 max-w-2xl text-sm text-brand-700">Acompanhe todas as ações registradas na plataforma em ordem cronológica.</p>
            </div>
            <a href="/admin" class="rounded-xl border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">
              ← Voltar ao painel
            </a>
          </div>
          <div class="mt-5">
            <div class="rounded-2xl bg-brand-100 p-4 inline-block">
              <p class="text-xs font-semibold uppercase tracking-wider">Total de registros</p>
              <p class="mt-2 font-display text-3xl font-bold"><%= logs.length %></p>
            </div>
          </div>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-bold">Registros</h2>
          <p class="mt-1 text-sm text-brand-700">Histórico completo de ações realizadas pelos usuários.</p>

          <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-200">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-brand-100 text-brand-800">
                <tr>
                  <th class="px-4 py-3 font-semibold">#</th>
                  <th class="px-4 py-3 font-semibold">Usuário</th>
                  <th class="px-4 py-3 font-semibold">Método</th>
                  <th class="px-4 py-3 font-semibold">Rota</th>
                  <th class="px-4 py-3 font-semibold">Descrição</th>
                  <th class="px-4 py-3 font-semibold">Data</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-200 bg-white">
                <% if (logs.length === 0) { %>
                  <tr>
                    <td colspan="6" class="px-4 py-6 text-center text-brand-600">Nenhum log registrado.</td>
                  </tr>
                <% } else { %>
                  <% logs.forEach(log => { %>
                    <tr class="hover:bg-brand-50">
                      <td class="px-4 py-3 text-brand-600"><%= log.id %></td>
                      <td class="px-4 py-3 font-medium"><%= log.userId ?? '—' %></td>
                      <td class="px-4 py-3">
                        <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold
                          <%= log.method === 'GET' ? 'bg-accent-500/10 text-accent-600' :
                              log.method === 'POST' ? 'bg-brand-200 text-brand-800' :
                              log.method === 'DELETE' ? 'bg-coral-500/10 text-coral-500' :
                              'bg-brand-100 text-brand-700' %>">
                          <%= log.method %>
                        </span>
                      </td>
                      <td class="px-4 py-3 font-mono text-xs text-brand-700"><%= log.route %></td>
                      <td class="px-4 py-3 text-brand-700"><%= log.description ?? '—' %></td>
                      <td class="px-4 py-3 text-brand-600"><%= log.createdAt %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>