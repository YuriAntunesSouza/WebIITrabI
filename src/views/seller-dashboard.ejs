<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Painel do vendedor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <li><a href="/seller/profile" class="hover:text-accent-600">Perfil da Loja</a></li>
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h1 class="font-display text-3xl font-bold">Painel do vendedor</h1>
          <p class="mt-1 text-sm text-brand-700">Gerencie vendas, estoque e desempenho dos anúncios.</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl bg-brand-100 p-4"><p class="text-xs font-semibold uppercase tracking-wider">Anúncios cadastrados</p><p class="mt-2 font-display text-3xl font-bold"><%= products.length %></p></div>
            <div class="rounded-2xl bg-brand-100 p-4"><p class="text-xs font-semibold uppercase tracking-wider">Fotos enviadas</p><p class="mt-2 font-display text-3xl font-bold"><%= products.reduce((acc, p) => acc + p.Images.length, 0) %></p></div>
            <div class="rounded-2xl bg-brand-100 p-4"><p class="text-xs font-semibold uppercase tracking-wider">Pedidos recebidos</p><p class="mt-2 font-display text-3xl font-bold"><%= orders.length %></p></div>
          </div>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-display text-2xl font-bold">Anúncios atuais</h2>
            <div class="flex gap-2">
              <input type="text" placeholder="Buscar anúncio" class="rounded-xl border border-brand-300 px-4 py-2 outline-none ring-accent-500 focus:ring" />
              <button class="rounded-xl bg-accent-500 px-4 py-2 font-semibold text-white">Buscar</button>
            </div>
          </div>
          <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-200">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-brand-100 text-brand-800">
                <tr>
                  <th class="px-4 py-3 font-semibold">Foto</th>
                  <th class="px-4 py-3 font-semibold">Item</th>
                  <th class="px-4 py-3 font-semibold">Categoria</th>
                  <th class="px-4 py-3 font-semibold">Estoque</th>
                  <th class="px-4 py-3 font-semibold">Preço</th>
                  <th class="px-4 py-3 font-semibold">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-200 bg-white">
                <% if (products.length === 0) { %>
                  <tr><td colspan="6" class="px-4 py-6 text-center text-brand-700">Nenhum produto cadastrado ainda.</td></tr>
                <% } %>
                <% products.forEach(p => { %>
                  <% const primary = p.Images.find(i => i.isPrimary) || p.Images[0]; %>
                  <tr>
                    <td class="px-4 py-3">
                      <% if (primary) { %>
                        <img src="<%= primary.imageUrl %>" class="h-10 w-10 rounded-lg object-cover" />
                      <% } else { %>
                        <span class="text-xs text-brand-500">Sem foto</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 font-semibold"><%= p.name %></td>
                    <td class="px-4 py-3"><%= p.category %></td>
                    <td class="px-4 py-3"><%= p.stock %></td>
                    <td class="px-4 py-3">R$ <%= p.price.toFixed(2) %></td>
                    <td class="px-4 py-3">
                      <div class="flex gap-2">
                        <a href="/products/<%= p.id %>" class="rounded-lg border border-brand-300 px-3 py-1.5 text-sm font-semibold hover:bg-brand-100">Ver</a>
                        <form action="/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Remover produto?')">
                          <button class="rounded-lg border border-coral-500 px-3 py-1.5 text-sm font-semibold text-coral-600 hover:bg-coral-50">Remover</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-bold">Pedidos recebidos</h2>
          <p class="mt-1 text-sm text-brand-700">Pedidos que contêm produtos seus.</p>
          <% if (orders.length === 0) { %>
            <p class="mt-4 text-sm text-brand-600">Nenhum pedido recebido ainda.</p>
          <% } else { %>
            <div class="mt-4 space-y-4">
              <% orders.forEach(order => { %>
                <%
                  const statusLabel = { pendente: 'Pendente', enviado: 'Enviado', entregue: 'Entregue', cancelado: 'Cancelado' };
                  const statusClass = {
                    pendente: 'bg-yellow-100 text-yellow-800',
                    enviado: 'bg-accent-500/10 text-accent-600',
                    entregue: 'bg-brand-200 text-brand-700',
                    cancelado: 'bg-coral-500/10 text-coral-600'
                  };
                %>
                <div class="rounded-2xl border border-brand-200 p-4">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <p class="font-semibold">Pedido #<%= order.id %> — <span class="text-brand-600"><%= order.User.name %></span></p>
                      <p class="text-xs text-brand-600"><%= new Date(order.createdAt).toLocaleDateString('pt-BR') %></p>
                    </div>
                    <form action="/orders/<%= order.id %>/status" method="POST" class="flex items-center gap-2">
                      <select name="status" class="rounded-xl border border-brand-300 px-3 py-1.5 text-sm outline-none focus:ring focus:ring-accent-500">
                        <option value="pendente"   <%= order.status === 'pendente'   ? 'selected' : '' %>>Pendente</option>
                        <option value="enviado"    <%= order.status === 'enviado'    ? 'selected' : '' %>>Enviado</option>
                        <option value="entregue"   <%= order.status === 'entregue'   ? 'selected' : '' %>>Entregue</option>
                        <option value="cancelado"  <%= order.status === 'cancelado'  ? 'selected' : '' %>>Cancelado</option>
                      </select>
                      <button type="submit" class="rounded-xl bg-accent-500 px-3 py-1.5 text-sm font-semibold text-white hover:bg-accent-600">Salvar</button>
                    </form>
                  </div>
                  <div class="mt-3 space-y-1">
                    <% order.Items.forEach(item => { %>
                      <p class="text-sm text-brand-700">
                        <%= item.Product.name %> — Qtd: <%= item.quantity %> &times; R$ <%= item.price.toFixed(2) %>
                      </p>
                    <% }) %>
                  </div>
                  <p class="mt-2 text-right font-bold text-coral-600">Total seus itens: R$ <%= order.Items.reduce((acc, i) => acc + i.price * i.quantity, 0).toFixed(2) %></p>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-bold">Novo produto</h2>

          <% if (error) { %>
            <div class="mt-3 rounded-xl bg-red-100 px-4 py-3 text-sm text-red-800"><%= error %></div>
          <% } %>
          <% if (success) { %>
            <div class="mt-3 rounded-xl bg-green-100 px-4 py-3 text-sm text-green-800"><%= success %></div>
          <% } %>

          <form action="/products" method="POST" enctype="multipart/form-data" class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-sm font-semibold">Nome</label>
              <input type="text" name="name" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
            </div>
            <div>
              <label class="block text-sm font-semibold">Categoria</label>
              <input type="text" name="category" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-sm font-semibold">Descrição</label>
              <textarea name="description" rows="2" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500"></textarea>
            </div>
            <div>
              <label class="block text-sm font-semibold">Preço (R$)</label>
              <input type="number" step="0.01" name="price" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
            </div>
            <div>
              <label class="block text-sm font-semibold">Estoque</label>
              <input type="number" name="stock" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-sm font-semibold">Fotos do produto (até 5)</label>
              <input type="file" name="images" multiple accept="image/*" class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5" />
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="w-full rounded-xl bg-accent-500 py-3 font-semibold text-white hover:bg-accent-600">Cadastrar produto</button>
            </div>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
