<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Categorias</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h1 class="font-display text-3xl font-bold">Navegue pelas categorias</h1>
          <p class="mt-1 text-sm text-brand-700">Explore produtos por categoria e refine sua busca.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="/categories" class="rounded-xl px-4 py-3 text-left font-semibold <%= !selectedCategory ? 'bg-brand-900 text-brand-50' : 'bg-brand-100 hover:bg-brand-200' %>">Todas</a>
            <% categories.forEach(cat => { %>
              <a href="/categories?category=<%= encodeURIComponent(cat) %>" class="rounded-xl px-4 py-3 text-left font-semibold <%= selectedCategory === cat ? 'bg-brand-900 text-brand-50' : 'bg-brand-100 hover:bg-brand-200' %>"><%= cat %></a>
            <% }) %>
          </div>
        </section>

        <% if (products.length === 0) { %>
          <section class="rounded-3xl border border-brand-200 bg-white p-10 text-center shadow-sm">
            <p class="text-brand-600">Nenhum produto encontrado nesta categoria.</p>
          </section>
        <% } else { %>
          <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <% products.forEach(product => { %>
              <% const primaryImage = product.Images.find(i => i.isPrimary) || product.Images[0]; %>
              <article class="rounded-2xl border border-brand-200 bg-white shadow-sm overflow-hidden">
                <% if (primaryImage) { %>
                  <img src="/uploads/<%= primaryImage.imageUrl %>" alt="<%= product.name %>" class="h-48 w-full object-cover" />
                <% } else { %>
                  <div class="h-48 w-full bg-brand-100 flex items-center justify-center text-brand-400 text-sm">Sem imagem</div>
                <% } %>
                <div class="p-4">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-600"><%= product.category %></p>
                  <h2 class="mt-1 font-display text-lg font-bold"><%= product.name %></h2>
                  <p class="mt-1 text-sm text-brand-700 line-clamp-2"><%= product.description %></p>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="font-bold text-coral-600">R$ <%= product.price.toFixed(2) %></span>
                    <a href="/products/<%= product.id %>" class="rounded-lg border border-brand-300 px-3 py-1.5 text-sm font-semibold hover:bg-brand-100">Ver</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </section>
        <% } %>
      </main>
    </div>
  </body>
</html>
