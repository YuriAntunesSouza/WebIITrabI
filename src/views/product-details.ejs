<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Detalhes do produto</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">

        <%
          const primaryImage = product.Images.find(i => i.isPrimary) || product.Images[0];
          const galleryImages = product.Images.filter(i => i !== primaryImage);
          const seller = product.User;
          const sellerProfile = seller.SellerProfile;
        %>

        <!-- Produto: imagem principal + info -->
        <section class="grid gap-6 rounded-3xl border border-brand-200 bg-white p-6 shadow-sm md:grid-cols-2">
          <div>
            <%
              const allImages = [...product.Images].sort((a,b) => (b.isPrimary||0) - (a.isPrimary||0));
            %>

            <% if (allImages.length > 0) { %>
              <!-- Imagem principal com setas de navegação -->
              <div class="relative">
                <img id="main-img" class="w-full rounded-2xl object-cover" style="max-height:400px"
                  src="<%= allImages[0].imageUrl %>" alt="<%= product.name %>" />
                <% if (allImages.length > 1) { %>
                  <button onclick="changeImg((currentImg-1+totalImgs)%totalImgs)"
                    class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/85 px-3 py-1.5 text-xl font-bold shadow hover:bg-white">&#8592;</button>
                  <button onclick="changeImg((currentImg+1)%totalImgs)"
                    class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/85 px-3 py-1.5 text-xl font-bold shadow hover:bg-white">&#8594;</button>
                <% } %>
              </div>

              <!-- Miniaturas clicáveis de todas as fotos -->
              <% if (allImages.length > 1) { %>
                <div class="mt-3 flex gap-2 overflow-x-auto pb-1">
                  <% allImages.forEach((img, i) => { %>
                    <img src="<%= img.imageUrl %>" alt="Foto <%= i+1 %>"
                      class="thumb h-20 w-20 flex-shrink-0 cursor-pointer rounded-xl border-2 object-cover hover:opacity-90 transition-all"
                      style="<%= i === 0 ? 'border-color:#0A7D7A' : 'border-color:#D9CEAA' %>"
                      onclick="changeImg(<%= i %>)" />
                  <% }) %>
                </div>
              <% } %>
            <% } else { %>
              <div class="flex h-64 items-center justify-center rounded-2xl border border-dashed border-brand-300 text-sm text-brand-700">
                Sem imagem
              </div>
            <% } %>

            <script>
              let currentImg = 0;
              const totalImgs = <%- allImages.length %>;
              const imgUrls = <%- JSON.stringify(allImages.map(i => i.imageUrl)) %>;
              function changeImg(idx) {
                currentImg = idx;
                document.getElementById('main-img').src = imgUrls[idx];
                document.querySelectorAll('.thumb').forEach((t, i) => {
                  t.style.borderColor = i === idx ? '#0A7D7A' : '#D9CEAA';
                });
              }
            </script>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-600"><%= product.category %></p>
            <h1 class="mt-1 font-display text-3xl font-bold"><%= product.name %></h1>
            <p class="mt-4 text-brand-700"><%= product.description %></p>
            <p class="mt-5 font-display text-4xl font-bold text-coral-600">
              R$ <%= product.price.toFixed(2) %>
            </p>
            <p class="mt-2 text-sm text-brand-700">Estoque: <%= product.stock %> unidades</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <% if (user) { %>
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="productId" value="<%= product.id %>" />
                  <input type="hidden" name="quantity" value="1" />
                  <button type="submit" class="rounded-xl bg-brand-900 px-5 py-2.5 font-semibold text-brand-50 hover:bg-brand-800">
                    Adicionar ao carrinho
                  </button>
                </form>
              <% } else { %>
                <a href="/login" class="rounded-xl bg-brand-900 px-5 py-2.5 font-semibold text-brand-50 hover:bg-brand-800">
                  Entrar para comprar
                </a>
              <% } %>
            </div>
          </div>
        </section>

        <!-- Card do vendedor -->
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-xl font-bold">Vendedor</h2>
          <div class="mt-3 flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold"><%= sellerProfile?.storeName || seller.name %></p>
              <% if (sellerProfile) { %>
                <p class="mt-1 text-sm text-brand-700"><%= sellerProfile.description %></p>
                <p class="mt-2 text-sm text-brand-700">
                  📍 <%= sellerProfile.city %> - <%= sellerProfile.state %>
                  &nbsp;|&nbsp;
                  📞 <%= sellerProfile.contact %>
                </p>
              <% } %>
            </div>
            <a href="/seller/public/<%= seller.id %>"
              class="whitespace-nowrap rounded-xl border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">
              Ver loja
            </a>
          </div>
        </section>

        <!-- Sistema de comentários -->
        <section id="comentarios" class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-xl font-bold">
            Comentários (<%= product.Comments.length %>)
          </h2>

          <!-- Formulário — só aparece para usuários logados -->
          <% if (userId) { %>
            <form action="/comments" method="POST" enctype="multipart/form-data"
              class="mt-4 space-y-3 rounded-2xl border border-brand-200 p-4">
              <input type="hidden" name="productId" value="<%= product.id %>" />
              <div>
                <label class="block text-sm font-semibold">Seu comentário</label>
                <textarea name="text" rows="3" required
                  class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500"></textarea>
              </div>
              <div>
                <label class="block text-sm font-semibold">Foto opcional</label>
                <input type="file" name="image" accept="image/*"
                  class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5" />
              </div>
              <button type="submit"
                class="rounded-xl bg-accent-500 px-5 py-2.5 font-semibold text-white hover:bg-accent-600">
                Publicar comentário
              </button>
            </form>
          <% } else { %>
            <p class="mt-3 text-sm text-brand-700">
              <a href="/login" class="font-semibold text-accent-600 hover:underline">Faça login</a>
              para deixar um comentário.
            </p>
          <% } %>

          <!-- Lista de comentários -->
          <div class="mt-6 space-y-4">
            <% if (product.Comments.length === 0) { %>
              <p class="text-sm text-brand-700">Nenhum comentário ainda. Seja o primeiro!</p>
            <% } %>

            <% product.Comments.forEach(comment => { %>
              <% const jasCurtiu = userId && comment.Likes.some(l => l.userId === userId); %>
              <div class="rounded-2xl border border-brand-200 p-4">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex-1">
                    <p class="text-sm font-semibold"><%= comment.User.name %></p>
                    <p class="text-xs text-brand-600">
                      <%= new Date(comment.createdAt).toLocaleString('pt-BR') %>
                    </p>
                    <p class="mt-2 text-brand-800"><%= comment.text %></p>
                    <% if (comment.imageUrl) { %>
                      <img src="<%= comment.imageUrl %>" alt="Foto do comentário"
                        class="mt-2 max-h-48 rounded-xl object-cover" />
                    <% } %>
                  </div>

                  <div class="flex flex-col items-end gap-2">
                    <!-- Curtida -->
                    <% if (userId) { %>
                      <form action="/comments/<%= comment.id %>/like" method="POST" class="flex items-center gap-1">
                        <button type="submit"
                          class="rounded-lg border px-3 py-1.5 text-sm font-semibold
                            <%= jasCurtiu ? 'border-coral-500 bg-coral-50 text-coral-600' : 'border-brand-300 hover:bg-brand-100' %>">
                          ♥ <%= comment.Likes.length %>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-sm text-brand-600">♥ <%= comment.Likes.length %></span>
                    <% } %>

                    <!-- Deletar (autor ou admin) -->
                    <% if (userId === comment.User.id || user?.role === 'administrador') { %>
                      <form action="/comments/<%= comment.id %>/delete" method="POST"
                        onsubmit="return confirm('Remover comentário?')">
                        <button type="submit"
                          class="rounded-lg border border-coral-500 px-3 py-1 text-xs font-semibold text-coral-600 hover:bg-coral-50">
                          Remover
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

      </main>
    </div>
  </body>
</html>
