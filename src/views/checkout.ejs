<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Finalização da compra</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <h1 class="font-display text-3xl font-bold">Finalização da compra</h1>
        <section class="grid gap-6 lg:grid-cols-3">
          <form action="/checkout" method="POST" class="space-y-4 rounded-3xl border border-brand-200 bg-white p-6 shadow-sm lg:col-span-2">
            <h2 class="font-display text-xl font-bold">Confirmar pedido</h2>
            <div class="space-y-2">
              <% items.forEach(item => { %>
                <% const img = item.product.Images.find(i => i.isPrimary) || item.product.Images[0]; %>
                <div class="flex items-center gap-3 rounded-xl border border-brand-200 p-3">
                  <% if (img) { %>
                    <img src="<%= img.imageUrl %>" class="h-12 w-12 rounded-lg object-cover flex-shrink-0" />
                  <% } %>
                  <div class="flex-1">
                    <p class="font-semibold"><%= item.product.name %></p>
                    <p class="text-sm text-brand-700">Qtd: <%= item.quantity %></p>
                  </div>
                  <p class="font-bold text-coral-600">R$ <%= item.subtotal.toFixed(2) %></p>
                </div>
              <% }) %>
            </div>
            <% if (profile) { %>
              <div class="rounded-xl bg-brand-100 p-4 text-sm text-brand-800">
                <p class="font-semibold">Endereço de entrega</p>
                <p class="mt-1"><%= profile.address %>, <%= profile.city %> - <%= profile.state %>, CEP <%= profile.zipCode %></p>
              </div>
            <% } else { %>
              <div class="rounded-xl bg-yellow-50 border border-yellow-200 p-4 text-sm text-yellow-800">
                Sem endereço cadastrado. <a href="/buyer/profile" class="font-semibold underline">Adicionar endereço</a>
              </div>
            <% } %>
            <button type="submit" class="w-full rounded-xl bg-brand-900 px-4 py-2.5 font-semibold text-brand-50 hover:bg-brand-800">Confirmar pedido</button>
          </form>

          <aside class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
            <h2 class="font-display text-xl font-bold">Total do pedido</h2>
            <div class="mt-4 space-y-2 text-sm text-brand-700">
              <div class="flex justify-between font-bold text-brand-900 text-base"><span>Total</span><span>R$ <%= total.toFixed(2) %></span></div>
            </div>
          </aside>
        </section>
      </main>
    </div>
  </body>
</html>
