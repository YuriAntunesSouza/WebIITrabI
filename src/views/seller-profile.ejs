<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MarketMVP | Perfil da Loja</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        fontFamily: { display: ["Space Grotesk","sans-serif"], body: ["Plus Jakarta Sans","sans-serif"] },
        colors: {
          brand:  { 50:"#F8F7F2",100:"#EDE8D8",200:"#D9CEAA",300:"#C7B57D",700:"#665024",900:"#251E10" },
          accent: { 500:"#0A7D7A", 600:"#075F5D" },
          coral:  { 500:"#E66A4E", 600:"#C85339" },
        }
      }}
    };
  </script>
</head>
<body class="font-body bg-brand-50 text-brand-900">
  <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
      <nav class="text-sm font-medium">
        <ul class="flex gap-5">
          <li><a href="/" class="hover:text-accent-600">Home</a></li>
          <li><a href="/seller" class="hover:text-accent-600">Painel</a></li>
          <li><a href="/seller/profile" class="text-accent-600 font-semibold">Perfil da Loja</a></li>
          <li>
            <a href="/logout" class="hover:text-coral-600">Sair</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-brand-200 bg-white p-8 shadow-sm">
      <h1 class="font-display text-3xl font-bold">Perfil da Loja</h1>
      <p class="mt-1 text-sm text-brand-700">Essas informações ficam visíveis para compradores.</p>

      <% if (success) { %>
        <div class="mt-4 rounded-xl bg-green-100 px-4 py-3 text-sm text-green-800"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="mt-4 rounded-xl bg-red-100 px-4 py-3 text-sm text-red-800"><%= error %></div>
      <% } %>

      <form action="/seller/profile" method="POST" class="mt-6 space-y-4">
        <div>
          <label class="block text-sm font-semibold">Nome da loja</label>
          <input type="text" name="storeName" value="<%= profile?.storeName || '' %>"
            class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
        </div>
        <div>
          <label class="block text-sm font-semibold">Descrição da loja</label>
          <textarea name="description" rows="3"
            class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500"><%= profile?.description || '' %></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold">Contato comercial (telefone ou email)</label>
          <input type="text" name="contact" value="<%= profile?.contact || '' %>"
            class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold">Cidade</label>
            <input type="text" name="city" value="<%= profile?.city || '' %>"
              class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
          </div>
          <div>
            <label class="block text-sm font-semibold">Estado (UF)</label>
            <input type="text" name="state" maxlength="2" value="<%= profile?.state || '' %>"
              class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold">Categorias que você trabalha</label>
          <input type="text" name="categories" value="<%= profile?.categories || '' %>"
            placeholder="Ex: Eletrônicos, Moda, Casa"
            class="mt-1 w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none focus:ring focus:ring-accent-500" />
        </div>
        <button type="submit"
          class="w-full rounded-xl bg-accent-500 py-3 font-semibold text-white hover:bg-accent-600">
          Salvar perfil
        </button>
      </form>
    </div>
  </main>
</body>
</html>