<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>MarketMVP | <%= seller.SellerProfile?.storeName || seller.name %></title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        fontFamily: { display: ["Space Grotesk","sans-serif"], body: ["Plus Jakarta Sans","sans-serif"] },
        colors: {
          brand:  { 50:"#F8F7F2",100:"#EDE8D8",200:"#D9CEAA",300:"#C7B57D",700:"#665024",900:"#251E10" },
          accent: { 500:"#0A7D7A", 600:"#075F5D" },
          coral:  { 500:"#E66A4E", 600:"#C85339" },
        }
      }}
    };
  </script>
</head>
<body class="font-body bg-brand-50 text-brand-900">
  <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
      <div class="flex items-center gap-2">
        <% if (user) { %>
          <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
        <% } else { %>
          <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
          <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 space-y-6">
    <div class="rounded-3xl border border-brand-200 bg-white p-8 shadow-sm">
      <h1 class="font-display text-3xl font-bold">
        <%= seller.SellerProfile?.storeName || seller.name %>
      </h1>
      <% if (seller.SellerProfile) { %>
        <p class="mt-2 text-brand-700"><%= seller.SellerProfile.description %></p>
        <div class="mt-4 flex flex-wrap gap-4 text-sm text-brand-700">
          <span>📍 <%= seller.SellerProfile.city %> - <%= seller.SellerProfile.state %></span>
          <span>📞 <%= seller.SellerProfile.contact %></span>
          <span>🏷️ <%= seller.SellerProfile.categories %></span>
        </div>
      <% } %>
    </div>

    <div class="rounded-3xl border border-brand-200 bg-white p-8 shadow-sm">
      <h2 class="font-display text-2xl font-bold mb-4">Produtos</h2>
      <% if (seller.Products.length === 0) { %>
        <p class="text-brand-700">Nenhum produto cadastrado ainda.</p>
      <% } else { %>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% seller.Products.forEach(p => { %>
            <a href="/products/<%= p.id %>" class="block rounded-2xl border border-brand-200 p-4 hover:border-accent-500 hover:shadow-sm transition-all">
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-600"><%= p.category %></p>
              <h3 class="mt-1 font-display text-lg font-bold"><%= p.name %></h3>
              <p class="mt-1 text-sm text-brand-700 line-clamp-2"><%= p.description %></p>
              <div class="mt-3 flex items-center justify-between">
                <span class="font-bold text-coral-600">R$ <%= p.price.toFixed(2) %></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>