<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Carrinho</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">LogOut</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <h1 class="font-display text-3xl font-bold">Seu carrinho</h1>
        <% if (items.length === 0) { %>
          <section class="rounded-3xl border border-brand-200 bg-white p-10 text-center shadow-sm">
            <p class="text-brand-700">Seu carrinho está vazio.</p>
            <a href="/" class="mt-4 inline-block rounded-xl bg-brand-900 px-5 py-2.5 font-semibold text-brand-50 hover:bg-brand-800">Ver produtos</a>
          </section>
        <% } else { %>
          <section class="grid gap-6 lg:grid-cols-3">
            <div class="space-y-3 lg:col-span-2">
              <% items.forEach(item => { %>
                <% const img = item.product.Images.find(i => i.isPrimary) || item.product.Images[0]; %>
                <article class="rounded-2xl border border-brand-200 bg-white p-4 shadow-sm">
                  <div class="flex items-center gap-4">
                    <% if (img) { %>
                      <img src="<%= img.imageUrl %>" class="h-16 w-16 rounded-xl object-cover flex-shrink-0" />
                    <% } %>
                    <div class="flex-1">
                      <h2 class="font-display text-lg font-bold"><%= item.product.name %></h2>
                      <p class="text-sm text-brand-700"><%= item.product.category %></p>
                      <p class="mt-1 text-sm text-brand-700">Qtd: <%= item.quantity %></p>
                    </div>
                    <div class="text-right">
                      <p class="font-bold text-coral-600">R$ <%= item.subtotal.toFixed(2) %></p>
                      <form action="/cart/remove" method="POST" class="mt-2">
                        <input type="hidden" name="productId" value="<%= item.product.id %>" />
                        <button type="submit" class="text-xs text-coral-600 hover:underline">Remover</button>
                      </form>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
            <aside class="rounded-2xl border border-brand-200 bg-white p-5 shadow-sm">
              <h2 class="font-display text-xl font-bold">Resumo do pedido</h2>
              <div class="mt-4 space-y-2 text-sm text-brand-700">
                <div class="flex justify-between font-bold text-brand-900"><span>Total</span><span>R$ <%= total.toFixed(2) %></span></div>
              </div>
              <a href="/checkout" class="mt-4 block w-full rounded-xl bg-brand-900 px-4 py-2.5 text-center font-semibold text-brand-50 hover:bg-brand-800">Ir para o pagamento</a>
            </aside>
          </section>
        <% } %>
      </main>
    </div>
  </body>
</html>
