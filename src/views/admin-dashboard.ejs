<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Painel administrativo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <ul class="flex gap-5">
              <li><a href="/" class="hover:text-accent-600">Home</a></li>
              <% if (user && user.role === "comprador") { %>
                <li><a href="/orders" class="hover:text-accent-600">Meus Pedidos</a></li>
              <% } %>
              <% if (user && user.role === "vendedor") { %>
                <li><a href="/seller" class="hover:text-accent-600">Painel do Vendedor</a></li>
              <% } %>
              <% if (user && user.role === "administrador") { %>
                <li><a href="/admin" class="hover:text-accent-600">Painel Admin</a></li>
                <li><a href="/admin/logs" class="hover:text-accent-600">Logs</a></li>
              <% } %>
            </ul>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Controle global da plataforma</p>
              <h1 class="mt-1 font-display text-3xl font-bold">Painel administrativo</h1>
              <p class="mt-2 max-w-2xl text-sm text-brand-700">Acompanhe contas cadastradas, identifique perfis com risco operacional e desative acessos quando necessário.</p>
            </div>
            <div class="rounded-2xl bg-brand-100 px-4 py-3 text-sm font-semibold text-brand-800">
              Administrador autenticado: admin@marketmvp.com
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas totais</p>
              <p id="total-accounts" class="mt-2 font-display text-3xl font-bold">4</p>
            </div>
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas ativas</p>
              <p id="active-accounts" class="mt-2 font-display text-3xl font-bold">3</p>
            </div>
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas desativadas</p>
              <p id="deactivated-today" class="mt-2 font-display text-3xl font-bold">1</p>
            </div>
          </div>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="font-display text-2xl font-bold">Lista de contas</h2>
              <p class="mt-1 text-sm text-brand-700">Visualize compradores, vendedores e administradores em uma única visão operacional.</p>
            </div>
            <div class="flex gap-2">
              <input type="text" placeholder="Buscar por nome, e-mail ou perfil" class="rounded-xl border border-brand-300 px-4 py-2 outline-none ring-accent-500 focus:ring" />
              <button class="rounded-xl bg-accent-500 px-4 py-2 font-semibold text-white hover:bg-accent-600">Buscar</button>
            </div>
          </div>

          <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-200">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-brand-100 text-brand-800">
                <tr>
                  <th class="px-4 py-3 font-semibold">Conta</th>
                  <th class="px-4 py-3 font-semibold">Perfil</th>
                  <th class="px-4 py-3 font-semibold">E-mail</th>
                  <th class="px-4 py-3 font-semibold">Último acesso</th>
                  <th class="px-4 py-3 font-semibold">Status</th>
                  <th class="px-4 py-3 font-semibold">Ações</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-200 bg-white">
                <% users.forEach(user => { %>
                  <tr>
                    <td><%= user.id %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role %></td>
                    <td>
                      <%= user.isActive ? "Ativo" : "Inativo" %>
                    </td>
                    <td>
                    <% if (user.isActive) { %>
                      <form action="/admin/deactivate/<%= user.id %>" method="POST">
                        <button type="submit">Desativar</button>
                      </form>
                    <% } else { %>
                      <span>Inativo</span>
                    <% } %>
                  </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
    <script>
      const statusStyles = {
        active: {
          text: "Ativa",
          classes: ["bg-accent-500/10", "text-accent-600"],
        },
        inactive: {
          text: "Desativada",
          classes: ["bg-brand-200", "text-brand-700"],
        },
      };

      const buttonStyles = {
        active: {
          text: "Desativar conta",
          add: ["bg-coral-500", "text-white", "hover:bg-coral-600"],
          remove: ["border", "border-brand-300", "hover:bg-brand-100"],
        },
        inactive: {
          text: "Reativar conta",
          add: ["border", "border-brand-300", "hover:bg-brand-100"],
          remove: ["bg-coral-500", "text-white", "hover:bg-coral-600"],
        },
      };

      function renderSummary() {
        const statuses = Array.from(document.querySelectorAll("[data-account-status]"));
        const totalAccounts = statuses.length;
        const activeAccounts = statuses.filter((status) => status.dataset.accountStatus === "active").length;
        const deactivatedToday = statuses.filter((status) => status.dataset.accountStatus === "inactive").length;

        document.getElementById("total-accounts").textContent = totalAccounts;
        document.getElementById("active-accounts").textContent = activeAccounts;
        document.getElementById("deactivated-today").textContent = deactivatedToday;
      }

      function setAccountState(button, nextState) {
        const row = button.closest("[data-account-row]");
        const status = row.querySelector("[data-account-status]");
        const statusStyle = statusStyles[nextState];
        const buttonStyle = buttonStyles[nextState];

        status.dataset.accountStatus = nextState;
        status.textContent = statusStyle.text;
        status.classList.remove("bg-accent-500/10", "text-accent-600", "bg-brand-200", "text-brand-700");
        status.classList.add(...statusStyle.classes);

        button.textContent = buttonStyle.text;
        button.classList.remove(...buttonStyle.remove);
        button.classList.add(...buttonStyle.add);

        renderSummary();
      }

      document.querySelectorAll("[data-toggle-account]").forEach((button) => {
        button.addEventListener("click", () => {
          const row = button.closest("[data-account-row]");
          const status = row.querySelector("[data-account-status]");
          const nextState = status.dataset.accountStatus === "active" ? "inactive" : "active";

          setAccountState(button, nextState);
        });
      });

      renderSummary();
    </script>
  </body>
</html>